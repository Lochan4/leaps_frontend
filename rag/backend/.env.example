# LLM calls use Claude Code's OAuth session — no API key needed.
# Make sure you are logged in: claude auth login

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Comma-separated list of allowed CORS origins.
# Defaults to localhost dev servers if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
